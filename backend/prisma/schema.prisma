// College Basketball Coach Sim - core data model
// SQLite for a simple, file-based, single-user-friendly backend.
// NOTE: SQLite has no native enum support in Prisma, so "enum-like" fields are
// plain Strings here; the allowed values are enforced as TS union types in
// backend/src/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Save management ----------

model SaveGame {
  id                String   @id @default(cuid())
  name              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  currentDate       DateTime
  currentSeasonYear Int
  currentPhase      String   @default("PRESEASON") // SeasonPhase
  coachTeamId       String?

  conferences      Conference[]
  teams            Team[]
  coaches          Coach[]
  athleticDirectors AthleticDirector[]
  assistantCoaches AssistantCoach[]
  players          Player[]
  prospects        Prospect[]
  walkOnCandidates WalkOnCandidate[]
  seasons          Season[]
  games            Game[]
  tournaments      Tournament[]
  gameEvents       GameEvent[]
  rivalries        Rivalry[]
  internationalTours InternationalTour[]
}

// ---------- League structure ----------
// Division: "D1" | "D2" | "D3"

model Conference {
  id           String   @id @default(cuid())
  saveGame     SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId   String
  name         String
  abbreviation String
  division     String

  teams        Team[]
  tournaments  Tournament[]

  @@index([saveGameId, division])
}

model Team {
  id                 String   @id @default(cuid())
  saveGame           SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId         String
  name               String
  state              String
  division           String
  conference         Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  conferenceId       String

  prestige           Int      @default(50) // 1-100
  nilBudget          Int      @default(100000) // annual NIL/booster dollars available
  facilitiesRating   Int      @default(50) // 1-100
  internationalScoutingRating Int @default(30) // 1-100, overseas scouting network strength
  academicReputation Int      @default(55) // 1-100, independent of prestige
  baseSalary         Int      @default(300000) // annual head coach salary this program pays, in dollars
  venueCapacity      Int      @default(5000) // home arena seating capacity
  arenaUpgradeRequestedThisSeason Boolean @default(false) // reset each offseason
  isPlayerControlled Boolean  @default(false)

  internationalTourCountry    String? // last country toured — program-scoped, source of the decaying recruiting boost
  internationalTourSeasonYear Int?    // season the last tour happened; gates the once-every-4-years cooldown

  players           Player[]
  prospectInterest  RecruitInterest[]
  transferInterest  TransferInterest[]
  walkOnCandidates  WalkOnCandidate[]
  headCoach         Coach?   @relation("HeadCoach", fields: [headCoachId], references: [id], onDelete: SetNull)
  headCoachId       String?  @unique
  assistants        AssistantCoach[]
  athleticDirector   AthleticDirector? @relation(fields: [athleticDirectorId], references: [id], onDelete: SetNull)
  athleticDirectorId String?  @unique

  homeGames         Game[]   @relation("HomeTeam")
  awayGames         Game[]   @relation("AwayTeam")
  internationalTours InternationalTour[]

  @@index([saveGameId, division])
  @@index([conferenceId])
}

// A team's once-every-4-years foreign exhibition tour: 3 exempt games against
// fabricated in-country opposition, simulated immediately (not scheduled as
// real Game rows — these don't touch standings/KenPom/RPI, matching how real
// exhibition games don't count against a team's official record).
model InternationalTour {
  id         String   @id @default(cuid())
  saveGame   SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String
  seasonYear Int
  country    String
  gamesJson  String   // JSON array of {opponentName, teamScore, opponentScore, win}
  createdAt  DateTime @default(now())

  @@index([saveGameId])
  @@index([teamId])
}

// ---------- Coaches ----------

model Coach {
  id                 String   @id @default(cuid())
  saveGame           SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId         String
  name               String
  isPlayerControlled Boolean  @default(false)

  reputation         Int      @default(50) // 1-100, drives job offers
  hotSeatLevel       Int      @default(0)  // 0-100, 100 = about to be fired
  offenseSkill       Int      @default(50)
  defenseSkill       Int      @default(50)
  recruitingSkill    Int      @default(50)
  developmentSkill   Int      @default(50)
  archetype          String   @default("PROGRAM_BUILDER") // CoachArchetype — every coach in the league has one
  background         String?  // CoachBackground — RPG-creator "past" choice, set only for the user's own coach

  playedCollege      Boolean  @default(false)
  collegeTeamName    String?
  collegeState       String?
  proPath            String   @default("NONE") // ProPath: NONE | DOMESTIC_PRO | OVERSEAS_PRO
  proCountry         String?  // set only when proPath is OVERSEAS_PRO

  legalityReputation Int      @default(75) // 1-100, program off-court integrity — image-conscious schools won't hire a coach whose players keep getting arrested

  hometownState      String?  // where the coach grew up / played HS ball
  pipelineStatesJson String   @default("{}") // Record<state, 0-100> recruiting-connection strength; persists across job changes
  transferPipelineJson String @default("{}") // Record<previousSchool, 0-100> — landing one transfer from a school makes the next one from there easier

  adRelationshipsJson String  @default("{}") // Record<athleticDirectorId, 0-100> — how ADs who've worked with this coach before remember them

  currentSalary            Int     @default(300000) // annual dollars, set on hire, can grow via granted raises
  raiseRequestedThisSeason Boolean @default(false) // reset each offseason

  teamPerception     Int      @default(65) // 1-100, locker room trust in the coach
  nationalPerception Int      @default(20) // 1-100, national media profile
  localPerception    Int      @default(50) // 1-100, local fanbase/booster goodwill
  campusAtmosphere   Int      @default(40) // 1-100, program culture/environment — builds slowly with sustained success and tenure, especially at lower divisions

  careerWins         Int      @default(0)
  careerLosses       Int      @default(0)
  yearsAtCurrentJob  Int      @default(0)

  team               Team?    @relation("HeadCoach")

  @@index([saveGameId])
}

// ---------- Athletic Directors ----------
// ADs hire/fire head coaches, have their own personal values, cycle through
// jobs (average ~7-year tenure) sometimes moving to a different school rather
// than retiring, and remember coaches they've worked with before.

model AthleticDirector {
  id                String   @id @default(cuid())
  saveGame          SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId        String
  name              String

  patience          Int      @default(50) // 1-100, damps/amplifies hot-seat swings
  winFocus          Int      @default(50) // 1-100, how much win/loss drives the hot seat vs everything else
  integrityStandard Int      @default(50) // 1-100, personal legality bar
  loyalty           Int      @default(50) // 1-100, how much a personal relationship protects (or dooms) a coach

  yearsAtCurrentJob Int      @default(0)

  team              Team?

  @@index([saveGameId])
}

// AssistantRole: "RECRUITING" | "PLAYER_DEVELOPMENT" | "OFFENSE" | "DEFENSE"

model AssistantCoach {
  id            String   @id @default(cuid())
  saveGame      SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId    String
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String?
  name          String
  role          String
  rating        Int      @default(50) // 1-100 in their specialty
  contractYears Int      @default(2)

  @@index([saveGameId, teamId])
}

// ---------- Players ----------
// PositionType: "PG" | "SG" | "SF" | "PF" | "C"
// ClassYear: "FR" | "SO" | "JR" | "SR" | "GR"
// PlayerOrigin: "HIGH_SCHOOL" | "JUCO" | "TRANSFER_PORTAL"

model Player {
  id               String   @id @default(cuid())
  saveGame         SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId       String
  team             Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String?

  firstName        String
  lastName         String
  position         String
  classYear        String
  heightInches     Int
  hometownState    String
  hometownCity     String   @default("") // real US city/town matching hometownState; "" for international
  countryOfOrigin  String?  // null = USA; set for international players and foreign-born HS recruits
  origin           String   @default("HIGH_SCHOOL")

  // Core ratings, 1-100
  scoring          Int
  threePoint       Int
  finishing        Int
  playmaking       Int
  rebounding       Int
  defense          Int
  athleticism      Int
  basketballIq     Int
  stamina          Int
  potential        Int      // ceiling, drives development

  // Off-court
  characterRating  Int      // 1-100 locker room reputation; low = drama-prone
  disciplineRating Int      @default(65) // 1-100 off-court judgment/legal risk; low = more incident-prone
  chemistryImpact  Int      @default(0) // computed modifier applied to team chemistry

  eligibilityYearsLeft Int  @default(4)
  inTransferPortal Boolean  @default(false)
  previousSchool   String?  // set when they entered the portal — the program they transferred from
  prioritiesJson   String   @default("{}") // JSON-encoded PriorityProfile, generated when they enter the portal
  isInjured        Boolean  @default(false)
  injuryWeeksLeft  Int      @default(0) // despite the name, this actually counts down in days
  injuryType       String?  // flavor name of the current injury (e.g. "Ankle sprain"), null when healthy
  isSuspended      Boolean  @default(false)
  suspensionDaysLeft Int    @default(0)
  onScholarship    Boolean  @default(true) // false = walk-on, no athletic aid

  gameStats        PlayerGameStat[]
  transferInterest TransferInterest[]

  @@index([saveGameId, teamId])
  @@index([saveGameId, inTransferPortal])
}

// ---------- Recruiting: HS + JUCO + international prospects, portal reuses Player.inTransferPortal ----------
// ProspectSource: "HIGH_SCHOOL" | "JUCO" | "INTERNATIONAL"

model Prospect {
  id               String   @id @default(cuid())
  saveGame         SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId       String

  firstName        String
  lastName         String
  position         String
  hometownState    String
  hometownCity     String   @default("")
  countryOfOrigin  String?  // null = USA; set for international prospects and foreign-born HS recruits
  source           String
  starRating       Int      // 1-5
  prioritiesJson   String   @default("{}") // JSON-encoded PriorityProfile — what this recruit actually cares about

  // True ratings (hidden ceiling of scouting accuracy is applied client-side via scoutingNoise)
  scoring          Int
  threePoint       Int
  finishing        Int
  playmaking       Int
  rebounding       Int
  defense          Int
  athleticism      Int
  basketballIq     Int
  potential        Int
  characterRating  Int
  disciplineRating Int      @default(65)
  scoutingNoise    Int      @default(10) // +/- uncertainty applied when displaying ratings to the user

  graduationYear   Int      // season year they become available to sign
  signed           Boolean  @default(false)
  committedTeamId  String?

  interest         RecruitInterest[]

  @@index([saveGameId, signed, graduationYear])
}

model RecruitInterest {
  id                String   @id @default(cuid())
  prospect          Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId        String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String

  interestLevel     Int      @default(0) // 0-100
  pointsInvested    Int      @default(0)
  offered           Boolean  @default(false)
  visitCompleted    Boolean  @default(false)

  @@unique([prospectId, teamId])
}

// Recruiting interest in an already-proven college player who has entered
// the transfer portal — mirrors RecruitInterest but points at a Player
// instead of a Prospect, since a transfer's true ratings are already known
// (no scouting noise) and they're gone from the pool the moment they land.
model TransferInterest {
  id                String   @id @default(cuid())
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId          String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String

  interestLevel     Int      @default(0) // 0-100
  pointsInvested    Int      @default(0)
  offered           Boolean  @default(false)

  @@unique([playerId, teamId])
}

// Walk-on tryout pool: local players and prospects who reached out on their
// own about walking on, regenerated for the user's team each offseason
// whenever the roster sits below the division's roster cap. Source:
// "LOCAL" | "REACHED_OUT".
model WalkOnCandidate {
  id               String   @id @default(cuid())
  saveGame         SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId       String
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String

  firstName        String
  lastName         String
  position         String
  hometownState    String
  hometownCity     String   @default("")
  countryOfOrigin  String?
  origin           String   @default("HIGH_SCHOOL")
  source           String   // "LOCAL" | "REACHED_OUT"

  scoring          Int
  threePoint       Int
  finishing        Int
  playmaking       Int
  rebounding       Int
  defense          Int
  athleticism      Int
  basketballIq     Int
  potential        Int
  characterRating  Int
  disciplineRating Int      @default(65)

  @@index([saveGameId, teamId])
}

// ---------- Seasons, games, tournaments ----------

model Season {
  id         String   @id @default(cuid())
  saveGame   SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId String
  year       Int

  @@unique([saveGameId, year])
}

model Game {
  id            String   @id @default(cuid())
  saveGame      SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId    String
  seasonYear    Int
  date          DateTime

  homeTeam      Team     @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  homeTeamId    String
  awayTeam      Team     @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  awayTeamId    String

  homeScore     Int?
  awayScore     Int?
  isPlayed      Boolean  @default(false)
  isConference  Boolean  @default(false)
  attendance    Int?     // home-crowd size, set once the game is played

  tournament    Tournament? @relation(fields: [tournamentId], references: [id])
  tournamentId  String?
  round         Int?     // 1 = first round, etc, for tournament games
  bracketSlot   Int?     // position within the round, used to reconstruct bracket adjacency for the next round

  playerStats   PlayerGameStat[]

  @@index([saveGameId, seasonYear])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model PlayerGameStat {
  id        String @id @default(cuid())
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  teamId    String // which side of the matchup this player represented in this specific game — fixed at simulation time, so it stays correct even after a later transfer

  minutes   Int
  points    Int
  rebounds  Int
  assists   Int
  steals    Int
  blocks    Int
  turnovers Int
  fgm       Int
  fga       Int
  threepm   Int
  threepa   Int
  ftm       Int
  fta       Int

  @@index([gameId])
  @@index([playerId])
  @@index([gameId, teamId])
}

// TournamentType: "CONFERENCE_TOURNAMENT" | "NCAA_TOURNAMENT" | "NIT" | "D2_NATIONAL" | "D3_NATIONAL"

model Tournament {
  id           String   @id @default(cuid())
  saveGame     SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId   String
  seasonYear   Int
  type         String
  name         String? // human-readable event name/location, set only for PRESEASON_INVITATIONAL
  division     String
  conference   Conference? @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  conferenceId String?

  games        Game[]

  @@index([saveGameId, seasonYear, type])
}

// A pair-of-teams row. teamAId/teamBId are always stored with teamAId < teamBId
// (lexicographic) so a pair only ever has one row. Seeded at world creation for
// same-state conference rivals (traditional rivalries); can also be forged
// mid-save once two teams have met enough times in the postseason.
model Rivalry {
  id                 String   @id @default(cuid())
  saveGame           SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId         String
  teamAId            String
  teamBId            String
  active             Boolean  @default(false) // true once it's a real rivalry (traditional, or crossed the postseason threshold)
  intensity          Int      @default(0) // 1-100, how big a deal this rivalry is
  postseasonMeetings Int      @default(0) // cumulative tournament-game meetings across all seasons — the trigger for forging new rivalries
  origin             String   @default("TRADITIONAL") // "TRADITIONAL" | "POSTSEASON"
  establishedYear    Int

  @@unique([saveGameId, teamAId, teamBId])
  @@index([saveGameId])
}

// ---------- Random events ----------
// EventStatus: "PENDING" | "RESOLVED"

model GameEvent {
  id             String   @id @default(cuid())
  saveGame       SaveGame @relation(fields: [saveGameId], references: [id], onDelete: Cascade)
  saveGameId     String
  seasonYear     Int
  date           DateTime
  type           String   // e.g. "INJURY", "TRANSFER_REQUEST", "BOOSTER_DEMAND", "JOB_OFFER", "CHEMISTRY_CONFLICT"
  title          String
  description    String
  teamId         String?
  playerId       String?
  status         String   @default("PENDING")
  optionsJson    String   // JSON-encoded array of { id, label, description, effects }
  chosenOptionId String?

  @@index([saveGameId, status])
}
